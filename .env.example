# API settings. Copy to .env (git-ignored) and adjust. The values below are the local
# defaults (they match docker-compose.yml); a variable set in the real environment wins
# over this file.

# PostgreSQL connection string.
DATABASE_URL=postgres://mama7k:mama7k@localhost:5433/mama7k?sslmode=disable

# Listen address of the API. The web dev server proxies /api and /media to it
# (set API_URL when running `npm run dev` if you change the port). When ADDR is not set,
# PORT (set by Render, Koyeb …) is used, else :8787.
ADDR=:8787

# Mark the session cookie Secure. Must be true in production (HTTPS).
COOKIE_SECURE=false

# How long a sign-in lasts, as a Go duration (720h = 30 days).
SESSION_TTL=720h

# Public URL of the image bucket: Cloudflare R2 → bucket → Settings → Public access
# (https://pub-….r2.dev or a custom domain). Not the "S3 API" endpoint. Image paths from
# the CSV import (e.g. master/characters/001_ludi.webp) are appended to it.
MEDIA_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Where images uploaded through the admin form are stored when R2 is not configured
# (development); served at /media.
UPLOAD_DIR=./uploads

# --- Production only --------------------------------------------------------------------

# Single-host setups only: a built web app (the web repo's dist/) to serve at / from the
# same origin. Leave empty in development (Vite serves the web app) and on Render, where
# the web app is its own static site.
# WEB_DIR=../web/dist

# Number of proxies in front of the API that append to X-Forwarded-For. Rate limits use the
# client IP, so set this on the host (usually 1) and check that the "ip" in the request log
# is your own public IP. 0 = use the TCP peer address (development).
# TRUSTED_PROXY_HOPS=1

# Cloudflare R2 for images uploaded through the admin form (container disks do not persist).
# R2 → Manage API tokens → create a token with Object Read & Write on the bucket. All four
# must be set; files go to <bucket>/<R2_UPLOAD_PREFIX>/<type>/<id>-<time>.<ext>.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_UPLOAD_PREFIX=master/uploads
